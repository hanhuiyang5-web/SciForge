{
	admin off
	auto_https disable_redirects
	https_port 8443
	servers :8443 {
		protocols h1 h2
		strict_sni_host on
		timeouts {
			read_header 10s
		}
	}
}

cloud-test.sciforge.cn:8443 {
	tls {
		protocols tls1.2 tls1.3
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			disable_http_challenge
		}
	}

	request_body {
		max_size 64KB
	}

	header {
		-Server
		X-SciForge-Edge-Revision "{$SCIFORGE_EDGE_COMMIT}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@console path /console*
	handle @console {
		header Cache-Control "no-store"
		respond 404
	}

	@portal path /portal /portal/*
	handle @portal {
		header {
			defer
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; manifest-src 'none'"
			X-SciForge-Portal-Mode "confidential-bff"
		}
		reverse_proxy {
			header_up X-Forwarded-For {remote_host}
			lb_try_duration 5s
			lb_try_interval 250ms
			dynamic a app 8787 {
				refresh 5s
				resolvers 127.0.0.11
				versions ipv4
			}
			transport http {
				dial_timeout 2s
				response_header_timeout 30s
			}
		}
	}

	handle {
		header Cache-Control "no-store"
		reverse_proxy {
			lb_try_duration 5s
			lb_try_interval 250ms
			dynamic a app 8787 {
				refresh 5s
				resolvers 127.0.0.11
				versions ipv4
			}
			transport http {
				dial_timeout 2s
				response_header_timeout 30s
			}
		}
	}
}

login-test.sciforge.cn:8443 {
	tls {
		protocols tls1.2 tls1.3
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			disable_http_challenge
		}
	}

	request_body {
		max_size 1MB
	}

	header {
		-Server
		Cache-Control "no-store"
		X-SciForge-Edge-Revision "{$SCIFORGE_EDGE_COMMIT}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	@forbidden path /admin* /metrics* /health*
	respond @forbidden 404

	@keycloak_public {
		path /realms/SciForge /realms/SciForge/* /resources/*
		path_regexp keycloak_public_case_sensitive ^(?:/realms/SciForge(?:/.*)?|/resources/.*)$
	}
	handle @keycloak_public {
		reverse_proxy {
			lb_try_duration 5s
			lb_try_interval 250ms
			dynamic a keycloak 8080 {
				refresh 5s
				resolvers 127.0.0.11
				versions ipv4
			}
			transport http {
				dial_timeout 2s
				response_header_timeout 30s
			}
		}
	}

	respond 404
}
