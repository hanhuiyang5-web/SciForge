# Generate each value separately with: openssl rand -hex 32
# Keep the real file only at /srv/sciforge-collaboration/secrets/collaboration.env,
# owned by root:root at mode 0600 under a physical root:root mode 0700 secrets
# directory. Never reuse these credentials.
SCIFORGE_COLLAB_DB_ADMIN_PASSWORD=replace_with_a_different_64_hex_characters
SCIFORGE_COLLAB_DB_PASSWORD=replace_with_64_hex_characters

# Published only on the ECS loopback interface.
SCIFORGE_COLLAB_HOST_PORT=8787

# Host path used by scripts/backup.sh. It is never mounted into a container.
SCIFORGE_COLLAB_BACKUP_DIR=/srv/sciforge-collaboration/backups

# Fixed runtime and log limits for the current 4 vCPU / 7.3 GiB A ECS.
# Deployment rejects other values and exports these validated literals so an
# ambient shell environment cannot override the selected root-only env file.
SCIFORGE_COLLAB_POSTGRES_CPUS=1.5
SCIFORGE_COLLAB_POSTGRES_MEMORY=2g
SCIFORGE_COLLAB_POSTGRES_PIDS=256
SCIFORGE_COLLAB_APP_CPUS=1.0
SCIFORGE_COLLAB_APP_MEMORY=768m
SCIFORGE_COLLAB_APP_PIDS=256
SCIFORGE_COLLAB_EDGE_CPUS=0.5
SCIFORGE_COLLAB_EDGE_MEMORY=256m
SCIFORGE_COLLAB_EDGE_PIDS=128
SCIFORGE_COLLAB_LOG_MAX_SIZE=10m
SCIFORGE_COLLAB_LOG_MAX_FILES=5

# Keep empty for loopback/private releases. Both explicit HTTPS releases require
# exactly https://cloud-test.sciforge.cn; Compose injects this value literally
# into the collaboration server process.
SCIFORGE_COLLABORATION_ALLOWED_ORIGINS=

# Required only for the core-only A HTTPS test edge. It is mutually exclusive
# with the OIDC test mode below.
SCIFORGE_A_HTTPS_TEST_EDGE_IPV4=replace_with_cloud_test_public_ipv4

# Persistent ACME account and certificate state for the A HTTPS test edge.
# The deployment creates data/ and config/ below this path as root, owned by
# 10002:10002 with mode 0700. Rollback must preserve this directory.
SCIFORGE_A_HTTPS_TEST_EDGE_STATE_DIR=/srv/sciforge-collaboration/a-https-test-edge

# Required only for a-https-oidc-test. Both hostnames must resolve only to this
# fixed IPv4. The state path is A-owned ACME state and must remain outside every
# fixed release. The Keycloak app is discovered only as keycloak:8080 on the
# dedicated external Docker network sciforge-keycloak_identity-edge; no
# Keycloak credential, realm export, or database setting belongs in this file.
SCIFORGE_A_HTTPS_OIDC_TEST_IPV4=replace_with_cloud_and_login_test_public_ipv4
SCIFORGE_A_HTTPS_OIDC_TEST_STATE_DIR=/srv/sciforge-collaboration/a-https-oidc-test

# Strict OIDC User authentication. Keep ISSUER empty for loopback/private and
# a-https-test-edge releases. For a-https-oidc-test it must be the exact HTTPS
# value below; the other three values are immutable in every mode. Even in OIDC
# test mode, trusted Zulip binding confirm and Provider Runtime remain disabled.
# SCIFORGE_COLLABORATION_OIDC_ISSUER=https://login-test.sciforge.cn/realms/SciForge
SCIFORGE_COLLABORATION_OIDC_ISSUER=
SCIFORGE_COLLABORATION_OIDC_AUDIENCE=sciforge-cloud-api
SCIFORGE_COLLABORATION_OIDC_AUTHORIZED_PARTIES=sciforge-desktop,sciforge-web-mobile
SCIFORGE_COLLABORATION_OIDC_ALLOW_INSECURE_LOOPBACK=false

# Required only for the fixed a-https-oidc-test collaboration Portal. The six
# non-secret values are immutable release inputs. Keycloak owns creation of the
# confidential sciforge-cloud-console client and its exact redirect; install a
# freshly delivered client secret only in the root-owned mode-0600 real env
# during the maintenance window. Never copy the secret into a release bundle,
# manifest, command transcript, ticket, or browser configuration.
SCIFORGE_COLLABORATION_PORTAL_ENABLED=true
SCIFORGE_COLLABORATION_PORTAL_ASSET_DIR=/app/node_modules/@sciforge/collaboration-portal/dist
SCIFORGE_COLLABORATION_PORTAL_PUBLIC_ORIGIN=https://cloud-test.sciforge.cn
SCIFORGE_COLLABORATION_PORTAL_OIDC_CLIENT_ID=sciforge-cloud-console
SCIFORGE_COLLABORATION_PORTAL_OIDC_CLIENT_SECRET=replace_with_keycloak_generated_confidential_client_secret
SCIFORGE_COLLABORATION_PORTAL_OIDC_REDIRECT_URI=https://cloud-test.sciforge.cn/portal/auth/callback
SCIFORGE_COLLABORATION_PORTAL_TEST_WORKER_DIRECTORY_ENABLED=true

# Read only when compose.provider-zulip.yml is explicitly included. Core-only
# deployment does not require or consume these paths.
SCIFORGE_COLLAB_PROVIDER_CONFIG_FILE=/srv/sciforge-collaboration/provider/providers.json
SCIFORGE_COLLAB_PROVIDER_SECRET_DIR=/srv/sciforge-collaboration/provider/secrets
