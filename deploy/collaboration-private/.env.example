# Generate each value separately with: openssl rand -hex 32
# Keep the real file only at /srv/sciforge-collaboration/secrets/collaboration.env,
# owned by root:root at mode 0600 under a physical root:root mode 0700 secrets
# directory. Never reuse these credentials.
SCIFORGE_COLLAB_DB_ADMIN_PASSWORD=replace_with_a_different_64_hex_characters
SCIFORGE_COLLAB_DB_PASSWORD=replace_with_64_hex_characters

# Published only on the ECS loopback interface.
SCIFORGE_COLLAB_HOST_PORT=8787

# Host path used by scripts/backup.sh. It is never mounted into a container.
SCIFORGE_COLLAB_BACKUP_DIR=/srv/sciforge-collaboration/backups

# Fixed runtime and log limits for the current 4 vCPU / 7.3 GiB A ECS.
# Deployment rejects other values and exports these validated literals so an
# ambient shell environment cannot override the selected root-only env file.
SCIFORGE_COLLAB_POSTGRES_CPUS=1.5
SCIFORGE_COLLAB_POSTGRES_MEMORY=2g
SCIFORGE_COLLAB_POSTGRES_PIDS=256
SCIFORGE_COLLAB_APP_CPUS=1.0
SCIFORGE_COLLAB_APP_MEMORY=768m
SCIFORGE_COLLAB_APP_PIDS=256
SCIFORGE_COLLAB_EDGE_CPUS=0.5
SCIFORGE_COLLAB_EDGE_MEMORY=256m
SCIFORGE_COLLAB_EDGE_PIDS=128
SCIFORGE_COLLAB_LOG_MAX_SIZE=10m
SCIFORGE_COLLAB_LOG_MAX_FILES=5

# Keep empty for loopback/private releases. The a-https-test-edge deployment
# requires exactly https://cloud-test.sciforge.cn; Compose injects this value
# literally into the collaboration server process.
SCIFORGE_COLLABORATION_ALLOWED_ORIGINS=

# Required only for the A HTTPS test edge. Set this to the single public IPv4
# address returned for cloud-test.sciforge.cn.
SCIFORGE_A_HTTPS_TEST_EDGE_IPV4=replace_with_cloud_test_public_ipv4

# Persistent ACME account and certificate state for the A HTTPS test edge.
# The deployment creates data/ and config/ below this path as root, owned by
# 10002:10002 with mode 0700. Rollback must preserve this directory.
SCIFORGE_A_HTTPS_TEST_EDGE_STATE_DIR=/srv/sciforge-collaboration/a-https-test-edge

# Optional strict OIDC User authentication. Leave ISSUER empty until the
# deployment's issuer is formally selected; User/Device/binding APIs then fail
# closed without restoring anonymous pairing or opaque User credentials.
SCIFORGE_COLLABORATION_OIDC_ISSUER=
SCIFORGE_COLLABORATION_OIDC_AUDIENCE=sciforge-cloud-api
SCIFORGE_COLLABORATION_OIDC_AUTHORIZED_PARTIES=sciforge-desktop,sciforge-web-mobile
SCIFORGE_COLLABORATION_OIDC_ALLOW_INSECURE_LOOPBACK=false

# Read only when compose.provider-zulip.yml is explicitly included. Core-only
# deployment does not require or consume these paths.
SCIFORGE_COLLAB_PROVIDER_CONFIG_FILE=/srv/sciforge-collaboration/provider/providers.json
SCIFORGE_COLLAB_PROVIDER_SECRET_DIR=/srv/sciforge-collaboration/provider/secrets
