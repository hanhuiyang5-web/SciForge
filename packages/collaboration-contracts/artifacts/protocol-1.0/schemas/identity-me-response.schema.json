      "type": "string"
    },
    "displayName": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "issuer": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    },
    "oidcIdentityId": {
