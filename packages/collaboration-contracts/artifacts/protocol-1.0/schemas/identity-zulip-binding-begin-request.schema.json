{
  "$id": "https://contracts.sciforge.invalid/collaboration/1.0/identity-zulip-binding-begin-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "idempotencyKey": {
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^idem_[A-Za-z0-9._:-]+$",
      "type": "string"
    },
    "realmUrl": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "realmUrl",
    "idempotencyKey"
  ],
  "title": "SciForge Collaboration identity-zulip-binding-begin-request",
  "type": "object",
  "x-sciforge-contract": {
    "contractCommit": "__SCIFORGE_COLLABORATION_COMMIT__",
    "protocolVersion": "1.0"
  },
  "x-sciforge-http": {
    "bindings": [
      {
        "body": "request",
        "method": "POST",
        "path": "/v1/integrations/zulip/bindings"
      }
    ]
  }
}
